[Unit]
Description=MAP-E CE (Customer Edge) daemon
Documentation=https://github.com/negineri/mapecd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/sbin/mapecd start
Restart=on-failure
RestartSec=5s

# /run/mapecd/ を起動時に作成
RuntimeDirectory=mapecd
RuntimeDirectoryMode=0755

# /var/lib/mapecd/ を作成（DUID ファイル保存先）
StateDirectory=mapecd
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
